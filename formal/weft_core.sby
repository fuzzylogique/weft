# SymbiYosys: core invariants for every possible instruction stream.
# The instruction word is a free input, so every task covers all programs.
#   bmc    every assertion holds on every 12-cycle trace (abc bmc3 and
#          smtbmc race; the first conclusive answer wins)
#   cover  the WAITT-completion, taken-branch, pin-write and illegal-halt
#          covers in weft_core.v are reachable (the bound is not vacuous)
#   prove  unbounded attempt with IC3/PDR; CI tolerates a timeout here
# Run one task: sby -f weft_core.sby bmc
[tasks]
bmc
cover
prove

[options]
bmc: mode bmc
bmc: depth 12
cover: mode cover
cover: depth 12
prove: mode prove
timeout 2400

[engines]
bmc: abc bmc3
bmc: smtbmc yices
cover: smtbmc yices
prove: abc pdr

[script]
read_verilog -formal -sv weft_regfile.v weft_timer.v weft_crc.v weft_core.v weft_core_formal.sv
prep -top weft_core_formal
memory_map
opt -fast
prove: chformal -cover -remove

[files]
../src/weft_regfile.v
../src/weft_timer.v
../src/weft_crc.v
../src/weft_core.v
weft_core_formal.sv
